
def caesar_cipher(text):
    result = ""
    shift = sum(int(char) for char in text if char.isdigit()) or 1

    for char in text:
        if char.isdigit():
            continue

        if char.isalpha() and char.isascii():
            base = ord("A") if char.isupper() else ord("a")
            result += chr((ord(char) - base + shift) % 26 + base)
        else:
            result += char

    return result

def caesar_cipherK(text):
    result = ""
    shift = sum(int(char) for char in text if char.isdigit()) or 1

